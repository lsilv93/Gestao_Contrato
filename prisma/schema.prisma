// Gestão de Contratos, Licenças Sanitárias (ANVISA), Manuais de Boas Práticas
// e Faturamento de transportadoras.
//
// Datas de vencimento usam @db.Date (sem hora): o farol compara o dia do
// vencimento com o dia atual no fuso America/Sao_Paulo.

generator client {
  provider        = "prisma-client-js"
  // relações (include) na MESMA consulta (JOIN LATERAL) em vez de uma consulta extra por relação
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN  // Consultoria: acesso total
  CLIENT // Transportadora: somente leitura dos dados do próprio CNPJ
}

enum ContractType {
  PJ
  SPOT
}

enum ContractStatus {
  ACTIVE     // Vigente
  RENEWED    // Renovado (substituído por um novo contrato)
  TERMINATED // Encerrado
}

// Ciclo: PENDING_EMISSION (NF ainda não emitida) → PENDING (aguardando pagamento) → PAID.
// "Atrasado" não é gravado: é um PENDING com vencimento anterior a hoje.
enum FinancialStatus {
  PENDING_EMISSION
  PENDING
  PAID
  CANCELED
}

// Ativa / Próxima de Vencer / Vencida são calculados a partir da validade de
// uma licença CURRENT. As demais situações encerram a licença.
enum LicenseStatus {
  CURRENT    // Vigente
  RENEWED    // Substituída por uma nova versão
  SUSPENDED  // Suspensa
  CANCELED   // Cancelada
  CLOSED     // Encerrada
}

/// Tipos do módulo "Licenças e Documentos". Categoria e obrigatoriedade da
/// validade ficam em src/domain/tiposDocumento.ts (AFE/AE: validade opcional).
enum DocumentType {
  CRF                          // Certidão de Regularidade (CRF)
  AFE_COSMETICOS
  AFE_CORRELATOS
  AFE_MEDICAMENTOS
  AFE_SANEANTES
  AE_MEDICAMENTOS_CONTROLADOS
  CLI
  AVCB
  LICENCA_POLICIA_FEDERAL
  LICENCA_POLICIA_CIVIL
  PGR
  PCMSO
  LIMPEZA_CAIXA_DAGUA
  CONTROLE_PRAGAS_EMPRESA
  CONTROLE_PRAGAS_VEICULOS
}

enum ManualCategory {
  MANUAL_BPA // Manual de Boas Práticas
  POP        // Procedimento Operacional Padrão
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CLIENT)
  /// CNPJ vinculado: obrigatório para CLIENT, opcional para ADMIN.
  carrierCnpj  String?
  carrier      Carrier? @relation(fields: [carrierCnpj], references: [cnpj], onUpdate: Cascade, onDelete: Restrict)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs     AuditLog[]
  uploadedFiles StoredFile[]

  @@index([carrierCnpj])
  @@map("users")
}

model Carrier {
  id           String  @id @default(cuid())
  /// CNPJ normalizado (14 caracteres, sem pontuação). Chave de filtro do RBAC.
  cnpj         String  @unique
  legalName    String
  tradeName    String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  zipCode      String?
  street       String?
  number       String?
  complement   String?
  district     String?
  city         String?
  state        String? @db.Char(2)
  active       Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users     User[]
  contracts Contract[]
  services  FinancialService[]
  licenses  SanitaryLicense[]
  manuals   GoodPracticesManual[]

  @@map("carriers")
}

model Contract {
  id             String         @id @default(cuid())
  carrierId      String
  carrier        Carrier        @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  contractType   ContractType
  title          String
  amount         Decimal        @default(0) @db.Decimal(14, 2)
  startDate      DateTime?      @db.Date
  expirationDate DateTime       @db.Date
  status         ContractStatus @default(ACTIVE)
  notes          String?
  /// Ciclo de faturamento: dia do mês em que a NF deve ser emitida (1–31; em meses curtos vale o último dia).
  invoiceDay     Int            @default(5)
  /// Dia do mês do vencimento do pagamento (menor que o dia de emissão = mês seguinte).
  dueDay         Int            @default(10)
  /// Valor previsto de cada NF mensal.
  billingAmount  Decimal        @db.Decimal(14, 2)
  /// Antecedência (dias) com que a pendência de emissão é gerada.
  emissionLeadDays Int          @default(0)
  fileId         String?        @unique
  file           StoredFile?    @relation("ContractFile", fields: [fileId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  services FinancialService[]

  @@index([carrierId])
  @@index([expirationDate])
  @@map("contracts")
}

model FinancialService {
  id            String          @id @default(cuid())
  carrierId     String
  carrier       Carrier         @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  contractId    String?
  contract      Contract?       @relation(fields: [contractId], references: [id], onDelete: SetNull)
  contractType  ContractType
  /// Número da NF (vazio enquanto PENDING_EMISSION).
  invoiceNumber String?
  description   String?
  /// Ciclo automático: competência "YYYY-MM" e data limite para emitir a NF.
  competence    String?
  emissionDate  DateTime?       @db.Date
  dueDate       DateTime        @db.Date
  paymentDate   DateTime?       @db.Date
  amount        Decimal         @db.Decimal(14, 2)
  status        FinancialStatus @default(PENDING)
  /// PDF ou XML da Nota Fiscal (baixado pelo cliente no aviso de pendência / bloqueio).
  fileId        String?         @unique
  file          StoredFile?     @relation("ServiceFile", fields: [fileId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([carrierId, invoiceNumber])
  /// no máximo uma pendência de emissão por contrato e mês
  @@unique([contractId, competence])
  @@index([dueDate])
  @@index([status])
  @@map("financial_services")
}

model SanitaryLicense {
  id             String        @id @default(cuid())
  carrierId      String
  carrier        Carrier       @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  /// Tipo do documento (vazio = registro anterior à classificação; o formulário exige).
  documentType   DocumentType?
  licenseNumber  String
  issuingBody    String?
  issueDate      DateTime?     @db.Date
  /// Vazia = "Sem Validade / Indeterminado" (permitido só para AFE/AE — CHECK no banco).
  expirationDate DateTime?     @db.Date
  status         LicenseStatus @default(CURRENT)
  version        Int           @default(1)
  notes          String?
  /// Versão anterior (histórico de renovações).
  previousId     String?       @unique
  previous       SanitaryLicense?  @relation("LicenseHistory", fields: [previousId], references: [id], onDelete: SetNull)
  next           SanitaryLicense?  @relation("LicenseHistory")
  fileId         String?       @unique
  file           StoredFile?   @relation("LicenseFile", fields: [fileId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([carrierId])
  @@index([expirationDate])
  @@index([documentType])
  @@map("sanitary_licenses")
}

model GoodPracticesManual {
  id         String         @id @default(cuid())
  carrierId  String
  carrier    Carrier        @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  title      String
  category   ManualCategory @default(MANUAL_BPA)
  version    String
  /// Próxima revisão (usada pelo farol).
  reviewDate DateTime?      @db.Date
  notes      String?
  fileId     String?        @unique
  file       StoredFile?    @relation("ManualFile", fields: [fileId], references: [id], onDelete: SetNull)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([carrierId])
  @@map("good_practices_manuals")
}

/// Arquivos (PDF/Word) guardados no próprio banco: o download passa pela API,
/// que confere o CNPJ do usuário antes de entregar o arquivo.
model StoredFile {
  id           String   @id @default(cuid())
  fileName     String
  mimeType     String
  size         Int
  data         Bytes
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  contract Contract?            @relation("ContractFile")
  license  SanitaryLicense?     @relation("LicenseFile")
  manual   GoodPracticesManual? @relation("ManualFile")
  service  FinancialService?    @relation("ServiceFile")

  @@map("stored_files")
}

/// Trilha de auditoria imutável (UPDATE/DELETE bloqueados por trigger no banco).
model AuditLog {
  /// ID da ação: UUID gerado pelo próprio PostgreSQL.
  id         String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: Restrict)
  userName   String?
  action     AuditAction
  entityName String
  entityId   String?
  /// Data/hora exata (UTC, com fuso).
  timestamp  DateTime    @default(now()) @db.Timestamptz(3)
  details    Json?

  @@index([entityName, entityId])
  @@index([timestamp])
  @@map("audit_logs")
}
