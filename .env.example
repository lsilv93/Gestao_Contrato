# PostgreSQL EXCLUSIVO deste sistema (não reutilize o banco do Control Tower Pallet).
# DATABASE_URL: conexão "pooled" usada pela aplicação.
# DATABASE_URL_UNPOOLED: conexão direta usada pelas migrações (opcional na Vercel).
DATABASE_URL="postgresql://gestao:gestao@localhost:5432/gestao?schema=public"
DATABASE_URL_UNPOOLED="postgresql://gestao:gestao@localhost:5432/gestao?schema=public"

# Segredo para assinar a sessão (gere com: openssl rand -base64 32)
AUTH_SECRET="troque-este-segredo-por-um-valor-aleatorio-longo"

# Administrador criado no primeiro deploy (somente se não existir nenhum usuário)
SEED_ADMIN_EMAIL="admin@consultoria.com.br"
SEED_ADMIN_PASSWORD="admin123"
